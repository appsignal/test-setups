#!/bin/bash

set -eu

# Install AppSignal, which is loaded before every PHP script.
# Composer is a PHP script too, so skip that autoload file for this one call:
# it fails while the dependencies it loads are not installed yet.
echo "Installing dependencies..."
php -d auto_prepend_file= /usr/local/bin/composer install --working-dir=/var/www/appsignal

cd /var/www/html

# The official image only copies WordPress into place and writes
# wp-config.php when it is asked to start Apache.
echo "Setting up WordPress files..."
docker-entrypoint.sh apache2 -v

if ! wp core is-installed --allow-root; then
  echo "Installing WordPress..."
  wp core install \
    --allow-root \
    --url="http://localhost:4001" \
    --title="AppSignal WordPress test app" \
    --admin_user="${WORDPRESS_ADMIN_USER}" \
    --admin_password="${WORDPRESS_ADMIN_PASSWORD}" \
    --admin_email="${WORDPRESS_ADMIN_EMAIL}" \
    --skip-email
  wp rewrite structure "/%postname%/" --allow-root

  # The test pages plugin throws an error when this post is viewed
  wp post create \
    --allow-root \
    --post_title="Error post" \
    --post_name="error-post" \
    --post_content="Viewing this post raises an error." \
    --post_status=publish
fi

# WordPress caches its URL rules, refresh them so the test pages are known
wp rewrite flush --allow-root

# WP-CLI runs as root, but Apache needs to write to the SQLite database
chown -R www-data:www-data wp-content/database

echo "Starting the application..."
exec apache2-foreground
